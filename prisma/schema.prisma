generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model users {
  id                    Int       @id @default(autoincrement())
  refId                 String?   @unique @db.VarChar(191)
  username              String    @unique @db.VarChar(150)
  email                 String?   @unique @db.VarChar(191)
  password_hash         String?   @db.VarChar(255)
  email_verified_at     DateTime? @db.DateTime(0)
  password_changed_at   DateTime? @db.DateTime(0)
  last_login_at         DateTime? @db.DateTime(0)
  must_change_password  Boolean   @default(false)
  failed_login_attempts Int       @default(0)
  locked_until          DateTime? @db.DateTime(0)
  citizen_id            String?   @db.Text
  firstname             String?   @db.Text
  lastname              String?   @db.Text
  role_id               Int?
  department_id         Int?
  position_id           Int?
  is_active             Boolean   @default(true)
  created_at            DateTime  @db.DateTime(0)
  updated_at            DateTime  @db.DateTime(0)

  role       role?        @relation(fields: [role_id], references: [id])
  department departments? @relation(fields: [department_id], references: [id])
  position   positions?   @relation(fields: [position_id], references: [id])
}

model departments {
  id         Int      @id @default(autoincrement())
  name       String   @db.Text
  is_active  Boolean  @default(true)
  created_at DateTime @db.DateTime(0)
  updated_at DateTime @db.DateTime(0)

  users users[]
}

model role {
  id         Int      @id @default(autoincrement())
  name       String   @db.Text
  is_active  Boolean  @default(true)
  created_at DateTime @db.DateTime(0)
  updated_at DateTime @db.DateTime(0)

  users users[]
}

model positions {
  id         Int      @id @default(autoincrement())
  name       String   @db.Text
  is_active  Boolean  @default(true)
  created_at DateTime @db.DateTime(0)
  updated_at DateTime @db.DateTime(0)

  users users[]
}

enum docs_qa_document_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum docs_wfme_standard_type {
  NONE
  BASIC
  QUALITY_DEV
}

model docs_departments {
  id                 Int      @id @default(autoincrement()) @db.UnsignedInt
  code               String   @unique @db.VarChar(20)
  name_th            String   @db.VarChar(150)
  name_en            String?  @db.VarChar(150)
  has_sub_department Boolean  @default(false)
  sort_order         Int      @default(0) @db.UnsignedInt
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamp(0)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(0)

  sub_departments docs_sub_departments[]
  documents       docs_qa_documents[]
  work_documents  docs_work_documents[]
}

model docs_sub_departments {
  document_workflow docs_document_workflow?
  id                Int                     @id @default(autoincrement()) @db.UnsignedInt
  department_id     Int                     @db.UnsignedInt
  code              String                  @db.VarChar(20)
  name_th           String                  @db.VarChar(150)
  name_en           String?                 @db.VarChar(150)
  sort_order        Int                     @default(0) @db.UnsignedInt
  is_active         Boolean                 @default(true)
  created_at        DateTime                @default(now()) @db.Timestamp(0)
  updated_at        DateTime                @default(now()) @updatedAt @db.Timestamp(0)

  department     docs_departments      @relation(fields: [department_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documents      docs_qa_documents[]
  work_documents docs_work_documents[]

  @@unique([department_id, code])
}

model docs_accreditation_frameworks {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  code         String   @unique @db.VarChar(20)
  prefix_char  String   @db.VarChar(5)
  name_th      String   @db.VarChar(150)
  name_en      String?  @db.VarChar(150)
  version_year String?  @db.VarChar(20)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(0)

  programs docs_programs[]
  criteria docs_qa_criteria[]
}

model docs_programs {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  code         String   @unique @db.VarChar(20)
  name_th      String   @db.VarChar(200)
  name_en      String?  @db.VarChar(200)
  framework_id Int      @db.UnsignedInt
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(0)

  framework           docs_accreditation_frameworks @relation(fields: [framework_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documents           docs_qa_documents[]
  curriculum_versions docs_curriculum_versions[]
  courses             docs_courses[]
  work_documents      docs_work_documents[]

  @@index([framework_id])
}

model docs_document_levels {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  code        String   @unique @db.VarChar(10)
  name_th     String   @db.VarChar(100)
  name_en     String?  @db.VarChar(100)
  level_order Int      @default(1) @db.UnsignedInt
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  documents docs_qa_documents[]
}

model docs_qa_criteria {
  id                 Int                     @id @default(autoincrement()) @db.UnsignedInt
  framework_id       Int                     @db.UnsignedInt
  parent_id          Int?                    @db.UnsignedInt
  code               String                  @db.VarChar(30)
  section_number     String                  @db.VarChar(20)
  level_depth        Int                     @default(1) @db.UnsignedInt
  wfme_standard_type docs_wfme_standard_type @default(NONE)
  title_th           String                  @db.VarChar(500)
  title_en           String?                 @db.VarChar(500)
  description_th     String?                 @db.Text
  is_selectable      Boolean                 @default(true)
  sort_order         Int                     @default(0) @db.UnsignedInt
  is_active          Boolean                 @default(true)
  created_at         DateTime                @default(now()) @db.Timestamp(0)
  updated_at         DateTime                @default(now()) @updatedAt @db.Timestamp(0)

  framework docs_accreditation_frameworks @relation(fields: [framework_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent    docs_qa_criteria?             @relation("criteria_tree", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children  docs_qa_criteria[]            @relation("criteria_tree")
  documents docs_qa_documents[]

  @@unique([framework_id, code])
  @@index([parent_id])
  @@index([framework_id, level_depth, sort_order])
}

model docs_qa_documents {
  id                   BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  document_code        String                  @unique @db.VarChar(100)
  sequence_no          String?                 @default("000") @db.VarChar(10)
  title                String                  @db.VarChar(500)
  description          String?                 @db.Text
  department_id        Int                     @db.UnsignedInt
  sub_department_id    Int?                    @db.UnsignedInt
  program_id           Int                     @db.UnsignedInt
  document_level_id    Int                     @db.UnsignedInt
  criterion_id         Int?                    @db.UnsignedInt
  current_version      String?                 @db.VarChar(20)
  approved_revision_no Int?                    @db.UnsignedSmallInt
  storage_location     String?                 @db.VarChar(1000)
  registry_version     Int                     @default(0) @db.UnsignedInt
  effective_date       DateTime?               @db.Date
  review_date          DateTime?               @db.Date
  file_path            String?                 @db.VarChar(1000)
  file_name            String?                 @db.VarChar(255)
  file_mime_type       String?                 @db.VarChar(100)
  file_size_bytes      BigInt?                 @db.UnsignedBigInt
  status               docs_qa_document_status @default(DRAFT)
  created_by           String?                 @db.VarChar(100)
  updated_by           String?                 @db.VarChar(100)
  created_at           DateTime                @default(now()) @db.Timestamp(0)
  updated_at           DateTime                @default(now()) @updatedAt @db.Timestamp(0)
  deleted_at           DateTime?               @db.Timestamp(3)
  deleted_by           String?                 @db.VarChar(100)
  deletion_reason      String?                 @db.VarChar(1000)

  department     docs_departments             @relation(fields: [department_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sub_department docs_sub_departments?        @relation(fields: [sub_department_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  program        docs_programs                @relation(fields: [program_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document_level docs_document_levels         @relation(fields: [document_level_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  criterion      docs_qa_criteria?            @relation(fields: [criterion_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revisions      docs_qa_document_revisions[]
  registry_changes docs_qa_registry_changes[]

  @@index([department_id, sub_department_id])
  @@index([program_id])
  @@index([document_level_id])
  @@index([criterion_id])
  @@index([status])
  @@index([deleted_at])
}

model audit_logs {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actor_id     String?  @db.VarChar(100)
  actor_name   String   @db.VarChar(150)
  action       String   @db.VarChar(30)
  entity_type  String   @db.VarChar(30)
  entity_id    String?  @db.VarChar(100)
  entity_label String?  @db.VarChar(500)
  outcome      String   @default("SUCCESS") @db.VarChar(20)
  summary      String   @db.VarChar(1000)
  details      Json?
  created_at   DateTime @default(now()) @db.Timestamp(3)

  @@index([created_at, id])
  @@index([actor_id, created_at])
  @@index([entity_type, entity_id])
  @@index([action, outcome])
}

model docs_qa_document_revisions {
  id              BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  document_id     BigInt               @db.UnsignedBigInt
  version_label   String               @db.VarChar(20)
  change_note     String?              @db.Text
  change_reason   String?              @db.Text
  file_path       String?              @db.VarChar(1000)
  file_name       String?              @db.VarChar(255)
  file_mime_type  String?              @db.VarChar(100)
  file_size_bytes BigInt?              @db.UnsignedBigInt
  uploaded_by     String?              @db.VarChar(100)
  created_at      DateTime             @default(now()) @db.Timestamp(0)
  title           String               @db.VarChar(500)
  description     String?              @db.Text
  status          docs_revision_status @default(DRAFT)
  auto_publish    Boolean              @default(false)
  revision_number Int?                 @db.UnsignedSmallInt
  open_slot       Int?                 @db.UnsignedTinyInt
  lock_version    Int                  @default(0) @db.UnsignedInt
  submitted_by    String?              @db.VarChar(100)
  submitted_at    DateTime?            @db.Timestamp(0)
  approved_by     String?              @db.VarChar(100)
  approved_at     DateTime?            @db.Timestamp(0)
  approved_name   String?              @db.VarChar(150)
  reviewed_by     String?              @db.VarChar(100)
  reviewed_name   String?              @db.VarChar(150)
  reviewed_at     DateTime?            @db.Timestamp(0)
  effective_date  DateTime?            @db.Date
  superseded_at   DateTime?            @db.Timestamp(0)
  superseded_by_version String?        @db.VarChar(20)
  withdrawn_by    String?              @db.VarChar(100)
  withdrawn_name  String?              @db.VarChar(150)
  withdrawn_at    DateTime?            @db.Timestamp(0)
  withdrawal_reason String?            @db.Text
  updated_at      DateTime             @default(now()) @updatedAt @db.Timestamp(3)

  document    docs_qa_documents       @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  events      docs_qa_review_events[]
  submissions docs_qa_submissions[]

  @@unique([document_id, open_slot])
  @@unique([document_id, revision_number])
  @@index([document_id])
  @@index([status, submitted_at])
  @@index([auto_publish, status, effective_date], map: "qa_revision_auto_effective_idx")
}

enum docs_revision_status {
  DRAFT
  PENDING
  APPROVED
  SUPERSEDED
  WITHDRAWN
}

model docs_qa_registry_changes {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  document_id     BigInt   @db.UnsignedBigInt
  previous_location String? @db.VarChar(1000)
  storage_location String?  @db.VarChar(1000)
  reason          String   @db.VarChar(2000)
  actor_id        String   @db.VarChar(100)
  actor_name      String   @db.VarChar(150)
  created_at      DateTime @default(now()) @db.Timestamp(3)
  document docs_qa_documents @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id, created_at])
}

model docs_qa_review_events {
  id            BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  revision_id   BigInt                     @db.UnsignedBigInt
  action        String                     @db.VarChar(30)
  actor_id      String                     @db.VarChar(100)
  actor_name    String                     @db.VarChar(150)
  comment       String?                    @db.Text
  created_at    DateTime                   @default(now()) @db.Timestamp(3)
  submission_id BigInt?                    @db.UnsignedBigInt
  revision      docs_qa_document_revisions @relation(fields: [revision_id], references: [id], onDelete: Cascade)
  submission    docs_qa_submissions?       @relation(fields: [submission_id], references: [id], onDelete: SetNull)

  @@index([revision_id, created_at])
  @@index([submission_id])
}

model docs_qa_submissions {
  id                 BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  revision_id        BigInt                     @db.UnsignedBigInt
  round_no           Int                        @db.UnsignedInt
  target_revision_no Int                        @db.UnsignedSmallInt
  title              String                     @db.VarChar(500)
  description        String?                    @db.Text
  change_note        String?                    @db.Text
  change_reason      String?                    @db.Text
  reviewer_id        String?                    @db.VarChar(100)
  reviewer_name      String?                    @db.VarChar(150)
  reviewer_at        DateTime?                  @db.Timestamp(0)
  effective_date     DateTime?                  @db.Date
  file_path          String                     @db.VarChar(1000)
  file_name          String                     @db.VarChar(255)
  file_mime_type     String?                    @db.VarChar(100)
  file_size_bytes    BigInt                     @db.UnsignedBigInt
  file_sha256        String?                    @db.Char(64)
  submitted_by       String                     @db.VarChar(100)
  submitted_name     String                     @db.VarChar(150)
  submitted_at       DateTime                   @db.Timestamp(3)
  captured_at        DateTime                   @default(now()) @db.Timestamp(3)
  source             String                     @default("SUBMITTED") @db.VarChar(20)
  status             docs_submission_status     @default(PENDING)
  reviewed_by        String?                    @db.VarChar(100)
  reviewed_name      String?                    @db.VarChar(150)
  reviewed_at        DateTime?                  @db.Timestamp(3)
  review_comment     String?                    @db.Text
  revision           docs_qa_document_revisions @relation(fields: [revision_id], references: [id], onDelete: Cascade)
  events             docs_qa_review_events[]

  @@unique([revision_id, round_no])
  @@index([status, submitted_at])
}

enum docs_submission_status {
  PENDING
  RETURNED
  APPROVED
}

enum docs_document_workflow {
  QAS
  CUR
  TCH
  ASM
  ADM
  STU
}

model docs_academic_years {
  id        Int                     @id @default(autoincrement()) @db.UnsignedInt
  year      Int                     @unique @db.UnsignedSmallInt
  is_active Boolean                 @default(true)
  offerings docs_course_offerings[]
  documents docs_work_documents[]
}

model docs_semesters {
  id         Int                     @id @default(autoincrement()) @db.UnsignedInt
  code       String                  @unique @db.VarChar(20)
  name_th    String                  @db.VarChar(100)
  sort_order Int                     @default(0) @db.UnsignedInt
  is_active  Boolean                 @default(true)
  offerings  docs_course_offerings[]
}

model docs_study_years {
  id        Int                     @id @default(autoincrement()) @db.UnsignedInt
  year      Int                     @unique @db.UnsignedTinyInt
  is_active Boolean                 @default(true)
  offerings docs_course_offerings[]
}

model docs_curriculum_versions {
  id         Int                   @id @default(autoincrement()) @db.UnsignedInt
  program_id Int                   @db.UnsignedInt
  year       Int                   @db.UnsignedSmallInt
  is_initial Boolean               @default(false)
  is_active  Boolean               @default(true)
  program    docs_programs         @relation(fields: [program_id], references: [id], onDelete: Restrict)
  documents  docs_work_documents[]

  @@unique([program_id, year])
}

model docs_courses {
  id         Int                     @id @default(autoincrement()) @db.UnsignedInt
  program_id Int                     @db.UnsignedInt
  code       String                  @db.VarChar(30)
  name_th    String                  @db.VarChar(200)
  is_active  Boolean                 @default(true)
  program    docs_programs           @relation(fields: [program_id], references: [id], onDelete: Restrict)
  offerings  docs_course_offerings[]

  @@unique([program_id, code])
}

model docs_course_offerings {
  id               Int                   @id @default(autoincrement()) @db.UnsignedInt
  course_id        Int                   @db.UnsignedInt
  academic_year_id Int                   @db.UnsignedInt
  semester_id      Int                   @db.UnsignedInt
  study_year_id    Int                   @db.UnsignedInt
  is_active        Boolean               @default(true)
  course           docs_courses          @relation(fields: [course_id], references: [id], onDelete: Restrict)
  academic_year    docs_academic_years   @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)
  semester         docs_semesters        @relation(fields: [semester_id], references: [id], onDelete: Restrict)
  study_year       docs_study_years      @relation(fields: [study_year_id], references: [id], onDelete: Restrict)
  documents        docs_work_documents[]

  @@unique([course_id, academic_year_id, semester_id, study_year_id])
  @@index([academic_year_id, semester_id, study_year_id])
}

model docs_work_documents {
  id                    BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  department_id         Int                       @db.UnsignedInt
  sub_department_id     Int                       @db.UnsignedInt
  program_id            Int                       @db.UnsignedInt
  academic_year_id      Int?                      @db.UnsignedInt
  curriculum_version_id Int?                      @db.UnsignedInt
  course_offering_id    Int?                      @db.UnsignedInt
  document_type         String                    @db.VarChar(30)
  title                 String                    @db.VarChar(500)
  file_path             String                    @db.VarChar(1000)
  file_name             String                    @db.VarChar(255)
  file_size_bytes       BigInt                    @db.UnsignedBigInt
  created_by            String                    @db.VarChar(100)
  created_at            DateTime                  @default(now()) @db.Timestamp(0)
  department            docs_departments          @relation(fields: [department_id], references: [id], onDelete: Restrict)
  sub_department        docs_sub_departments      @relation(fields: [sub_department_id], references: [id], onDelete: Restrict)
  program               docs_programs             @relation(fields: [program_id], references: [id], onDelete: Restrict)
  academic_year         docs_academic_years?      @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)
  curriculum_version    docs_curriculum_versions? @relation(fields: [curriculum_version_id], references: [id], onDelete: Restrict)
  course_offering       docs_course_offerings?    @relation(fields: [course_offering_id], references: [id], onDelete: Restrict)

  @@index([department_id, sub_department_id, program_id, academic_year_id])
  @@index([curriculum_version_id])
  @@index([course_offering_id])
}
