generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model users {
  id                    Int       @id @default(autoincrement())
  refId                 String?   @unique @db.VarChar(191)
  username              String    @db.Text
  email                 String?   @unique @db.VarChar(191)
  password_hash         String?   @db.VarChar(255)
  email_verified_at     DateTime? @db.DateTime(0)
  password_changed_at   DateTime? @db.DateTime(0)
  last_login_at         DateTime? @db.DateTime(0)
  must_change_password  Boolean   @default(false)
  failed_login_attempts Int       @default(0)
  locked_until          DateTime? @db.DateTime(0)
  citizen_id            String?   @db.Text
  firstname             String?   @db.Text
  lastname              String?   @db.Text
  role_id               Int?
  department_id         Int?
  position_id           Int?
  isActive              Boolean   @default(true)
  created_at            DateTime  @db.DateTime(0)
  updated_at            DateTime  @db.DateTime(0)

  role       role?        @relation(fields: [role_id], references: [id])
  department departments? @relation(fields: [department_id], references: [id])
  position   positions?   @relation(fields: [position_id], references: [id])
}

model departments {
  id          Int      @id @default(autoincrement())
  name        String   @db.Text
  isActive    Boolean  @default(true)
  employee_id Int
  created_at  DateTime @db.DateTime(0)
  updated_at  DateTime @db.DateTime(0)

  users users[]
}

model role {
  id          Int      @id @default(autoincrement())
  name        String   @db.Text
  isActive    Boolean  @default(true)
  employee_id Int
  created_at  DateTime @db.DateTime(0)
  updated_at  DateTime @db.DateTime(0)

  users users[]
}

model positions {
  id          Int      @id @default(autoincrement())
  name        String   @db.Text
  isActive    Boolean  @default(true)
  employee_id Int
  created_at  DateTime @db.DateTime(0)
  updated_at  DateTime @db.DateTime(0)

  users users[]
}

enum docs_qa_document_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum docs_wfme_standard_type {
  NONE
  BASIC
  QUALITY_DEV
}

model docs_departments {
  id                 Int      @id @default(autoincrement()) @db.UnsignedInt
  code               String   @unique @db.VarChar(20)
  name_th            String   @db.VarChar(150)
  name_en            String?  @db.VarChar(150)
  has_sub_department Boolean  @default(false)
  sort_order         Int      @default(0) @db.UnsignedInt
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamp(0)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(0)

  sub_departments docs_sub_departments[]
  documents       docs_qa_documents[]
}

model docs_sub_departments {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  department_id Int      @db.UnsignedInt
  code          String   @db.VarChar(20)
  name_th       String   @db.VarChar(150)
  name_en       String?  @db.VarChar(150)
  sort_order    Int      @default(0) @db.UnsignedInt
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(0)

  department docs_departments    @relation(fields: [department_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documents  docs_qa_documents[]

  @@unique([department_id, code])
}

model docs_accreditation_frameworks {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  code         String   @unique @db.VarChar(20)
  prefix_char  String   @db.VarChar(5)
  name_th      String   @db.VarChar(150)
  name_en      String?  @db.VarChar(150)
  version_year String?  @db.VarChar(20)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(0)

  programs docs_programs[]
  criteria docs_qa_criteria[]
}

model docs_programs {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  code         String   @unique @db.VarChar(20)
  name_th      String   @db.VarChar(200)
  name_en      String?  @db.VarChar(200)
  framework_id Int      @db.UnsignedInt
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(0)

  framework docs_accreditation_frameworks @relation(fields: [framework_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documents docs_qa_documents[]

  @@index([framework_id])
}

model docs_document_levels {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  code        String   @unique @db.VarChar(10)
  name_th     String   @db.VarChar(100)
  name_en     String?  @db.VarChar(100)
  level_order Int      @default(1) @db.UnsignedInt
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  documents docs_qa_documents[]
}

model docs_qa_criteria {
  id                 Int                     @id @default(autoincrement()) @db.UnsignedInt
  framework_id       Int                     @db.UnsignedInt
  parent_id          Int?                    @db.UnsignedInt
  code               String                  @db.VarChar(30)
  section_number     String                  @db.VarChar(20)
  level_depth        Int                     @default(1) @db.UnsignedInt
  wfme_standard_type docs_wfme_standard_type @default(NONE)
  title_th           String                  @db.VarChar(500)
  title_en           String?                 @db.VarChar(500)
  description_th     String?                 @db.Text
  is_selectable      Boolean                 @default(true)
  sort_order         Int                     @default(0) @db.UnsignedInt
  is_active          Boolean                 @default(true)
  created_at         DateTime                @default(now()) @db.Timestamp(0)
  updated_at         DateTime                @default(now()) @updatedAt @db.Timestamp(0)

  framework docs_accreditation_frameworks @relation(fields: [framework_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent    docs_qa_criteria?             @relation("criteria_tree", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children  docs_qa_criteria[]            @relation("criteria_tree")
  documents docs_qa_documents[]

  @@unique([framework_id, code])
  @@index([parent_id])
  @@index([framework_id, level_depth, sort_order])
}

model docs_qa_documents {
  id                BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  document_code     String                  @unique @db.VarChar(100)
  sequence_no       String?                 @default("000") @db.VarChar(10)
  title             String                  @db.VarChar(500)
  description       String?                 @db.Text
  department_id     Int                     @db.UnsignedInt
  sub_department_id Int?                    @db.UnsignedInt
  program_id        Int                     @db.UnsignedInt
  document_level_id Int                     @db.UnsignedInt
  criterion_id      Int                     @db.UnsignedInt
  current_version   String                  @default("1.0") @db.VarChar(20)
  effective_date    DateTime?               @db.Date
  review_date       DateTime?               @db.Date
  file_path         String?                 @db.VarChar(1000)
  file_name         String?                 @db.VarChar(255)
  file_mime_type    String?                 @db.VarChar(100)
  file_size_bytes   BigInt?                 @db.UnsignedBigInt
  status            docs_qa_document_status @default(DRAFT)
  created_by        String?                 @db.VarChar(100)
  updated_by        String?                 @db.VarChar(100)
  created_at        DateTime                @default(now()) @db.Timestamp(0)
  updated_at        DateTime                @default(now()) @updatedAt @db.Timestamp(0)

  department     docs_departments             @relation(fields: [department_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sub_department docs_sub_departments?        @relation(fields: [sub_department_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  program        docs_programs                @relation(fields: [program_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document_level docs_document_levels         @relation(fields: [document_level_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  criterion      docs_qa_criteria             @relation(fields: [criterion_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revisions      docs_qa_document_revisions[]

  @@index([department_id, sub_department_id])
  @@index([program_id])
  @@index([document_level_id])
  @@index([criterion_id])
  @@index([status])
}

model docs_qa_document_revisions {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  document_id     BigInt   @db.UnsignedBigInt
  version_label   String   @db.VarChar(20)
  change_note     String?  @db.Text
  file_path       String   @db.VarChar(1000)
  file_name       String   @db.VarChar(255)
  file_mime_type  String?  @db.VarChar(100)
  file_size_bytes BigInt?  @db.UnsignedBigInt
  uploaded_by     String?  @db.VarChar(100)
  created_at      DateTime @default(now()) @db.Timestamp(0)

  document docs_qa_documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([document_id])
}
